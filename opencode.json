{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "default_agent": "supervisor",
  "subagent_depth": 3,
  "agent": {
    "supervisor": {
      "permission": {
        "chrome-devtools_*": "allow",
        "macos-use_*": "allow",
        "playwright_*": "allow",
        "vercel_*": "allow",
        "railway_*": "allow"
      },
      "options": {}
    }
  },
  "command": {},
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"],
      "enabled": false
    },
    "elevenlabs": {
      "type": "local",
      "command": ["uvx", "elevenlabs-mcp"],
      "enabled": false,
      "environment": {
        "ELEVENLABS_API_KEY": "YOUR_ELEVENLABS_KEY"
      }
    },
    "yt-dlp": {
      "type": "local",
      "command": ["npx", "-y", "@kevinwatt/yt-dlp-mcp@latest"],
      "enabled": false
    },
    "vercel": {
      "type": "local",
      "command": ["npx", "-y", "vercel-mcp-pro"],
      "enabled": false,
      "environment": {
        "VERCEL_TOKEN": "YOUR_VERCEL_TOKEN"
      }
    },
    "gemini-api-docs": {
      "type": "local",
      "command": ["uvx", "--from", "git+https://github.com/philschmid/gemini-api-docs-mcp", "gemini-docs-mcp"],
      "enabled": false
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": false
    },
    "railway": {
      "type": "local",
      "command": ["railway", "mcp"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_TOKEN"
      }
    },
    "macos-use": {
      "type": "local",
      "command": ["/usr/local/bin/mcp-server-macos-use"],
      "enabled": false
    }
  },
  "permission": {
    "chrome-devtools_*": "allow",
    "macos-use_*": "allow",
    "vercel_*": "allow",
    "elevenlabs_*": "allow",
    "playwright_*": "allow",
    "yt-dlp_*": "allow",
    "gemini-api-docs_*": "allow",
    "context7_*": "allow",
    "railway_*": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "plugin": ["observer-bridge.js"],
  "provider": {
    "ollama": {
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B (local — fast GPU)"
        },
        "qwen3-coder:30b": {
          "name": "Qwen 3 Coder 30B (local — best quality)"
        },
        "deepseek-r1:32b": {
          "name": "DeepSeek R1 32B (local)"
        },
        "gemma4:12b": {
          "name": "Gemma4 12B (local)"
        },
        "gemma4:26b": {
          "name": "Gemma4 26B (local)"
        },
        "qwen3.5:27b": {
          "name": "Qwen3.5 27B (local)"
        }
      }
    }
  },
  "disabled_providers": []
}
